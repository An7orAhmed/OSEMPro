{
  "name": "osempro",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src packages tests",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "db:generate": "prisma generate",
    "db:check": "node scripts/check-db.mjs",
    "db:push": "prisma db push",
    "db:smoke": "npm run db:generate && tsx scripts/test-prisma.mts",
    "db:validate": "prisma validate",
    "engines:build:renvo": "bash scripts/build-renvo.sh",
    "build:with-engines": "npm run engines:build:renvo && npm run build"
  },
  "dependencies": {
    "@osempro/simulator": "file:packages/simulator",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/composer": "0.38.0",
    "@prisma/composer-prisma-cloud": "0.38.0",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "dotenv": "^18.0.10",
    "effect": "4.0.5",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.90.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/platform-node-shared": "4.0.5",
    "@effect/vitest": "4.0.5"
  }
}
